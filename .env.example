# ---- Ananta Legal (Next.js) configuration ----
# Copy to ".env.local" for local dev (git-ignored), or set these as
# Environment Variables in the Vercel project settings.
# DO NOT put real secrets in this example file.

# ---- Frontend ----
# Base URL of the API. Leave BLANK for the normal single-app deploy (frontend
# and API routes live on the same Vercel domain, so the app just calls
# "/api/..."). Only set this if the API is hosted separately (no trailing slash).
NEXT_PUBLIC_API_URL=

# ---- Database ----
# PostgreSQL connection string (stores blog posts). Use a hosted Postgres
# (Neon, Supabase, Render, Vercel Postgres). The "posts" table is created
# automatically on first request.
DATABASE_URL=

# ---- Admin session ----
# Long random string used to encrypt the admin session cookie.
# MUST be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Admin credentials for the blog editor. Login is disabled until ADMIN_PASSWORD is set.
ADMIN_USER=admin
ADMIN_PASSWORD=

# ---- Image storage (blog editor uploads) ----
# REQUIRED in production (Vercel's filesystem is read-only). Get this from the
# Cloudinary dashboard (Account Details). In local dev only, if this is unset,
# images are written to public/uploads/ instead.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ---- Enquiry form email (Contact page) ----
# PREFERRED: Brevo's HTTPS API key (Brevo -> SMTP & API -> API Keys -> Generate
# a new API key, NOT the SMTP key). Sends over port 443.
BREVO_API_KEY=
# Inbox that receives enquiries. Defaults to anantalegal9@gmail.com if unset.
MAIL_TO=anantalegal9@gmail.com
# "From" address on outgoing mail. MUST be on a domain you've verified with your
# mail provider (SPF/DKIM/DMARC). Do NOT use a @gmail.com/@yahoo.com address here.
MAIL_FROM=no-reply@ananta-legal.com

# FALLBACK only (used when BREVO_API_KEY is unset): plain SMTP.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
